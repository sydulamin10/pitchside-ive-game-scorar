# --------------------------------------------------------------------------
# Pitchside web app — build-time configuration.
#
# Copy to `.env.local` for development. Everything prefixed with VITE_ is
# embedded in the JavaScript bundle and is therefore PUBLIC: never put a
# secret, API key, or database URL in this file.
# --------------------------------------------------------------------------

# Base URL of the API. Leave empty to call the same origin through /api,
# which is what the dev proxy and a single-edge production deploy both do.
# ODCC production (cPanel web → Render API):
# VITE_API_BASE_URL=https://pitchside-api-kugn.onrender.com
VITE_API_BASE_URL=

# Where the dev server proxies /api to.
VITE_DEV_API_TARGET=http://127.0.0.1:8000

# Shown in the footer and the "report an issue" link.
VITE_SUPPORT_EMAIL=support@example.org
