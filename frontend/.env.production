# Production build values (untracked, like every other real .env).
# Used by `npm run build`; deploy/cpanel/build-odcc-web.ps1 overrides these
# from the environment and also writes dist/runtime-config.js.
#
# The API allows https://odcc.live and https://www.odcc.live as CORS origins,
# so the browser calls it directly — REST and the SSE live-score feed alike.
VITE_API_BASE_URL=https://api.odcc.live
