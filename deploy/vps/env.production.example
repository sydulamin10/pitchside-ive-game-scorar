# ---------------------------------------------------------------------------
# ODCC LIVE API - production environment template for the VPS deployment.
#
# Copy to /opt/odcc-api/.env.production on the server and fill in the real
# values. Never commit the filled-in file: it is read by docker compose as
# `env_file` and should be chmod 600, owned by root.
#
# Generate SECRET_KEY on the server so it never exists anywhere else:
#   openssl rand -hex 48
# ---------------------------------------------------------------------------

ENV=production
DEBUG=false
PROJECT_NAME=ODCC LIVE
API_V1_PREFIX=/api/v1

# Minimum 32 chars, and the app rejects obvious placeholders in production.
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_48
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
# The web app and API share the registrable domain odcc.live, but the SPA keeps
# the refresh token in storage rather than a cookie, so this stays off.
AUTH_REFRESH_COOKIE_ENABLED=false
ALLOW_REGISTRATION=true

PUBLIC_WEB_URL=https://odcc.live
PUBLIC_API_URL=https://api.odcc.live

# Exact web origins. "*" is refused in production because credentials are
# allowed. The browser calls the API cross-origin, so this must be right or
# every request fails preflight.
CORS_ORIGINS=https://odcc.live,https://www.odcc.live
# Host header allowlist. Includes localhost so the container healthcheck and
# local curl probes are not rejected by TrustedHostMiddleware.
ALLOWED_HOSTS=api.odcc.live,odcc.live,www.odcc.live,localhost,127.0.0.1
# Media PUTs are exempt from this and capped by MEDIA_MAX_BYTES instead.
MAX_REQUEST_BODY_BYTES=1048576

# Neon Postgres. Must keep sslmode=require.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Runs `alembic upgrade head` on start-up, in addition to the image's CMD.
AUTO_MIGRATE=true
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true

# Upstash Redis over TLS. Optional, but without it the live-score fan-out is
# in-process only, so multiple API containers would drift apart.
REDIS_URL=rediss://default:PASSWORD@HOST.upstash.io:6379
REDIS_KEY_PREFIX=pitchside

RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_15MIN=20
RATE_LIMIT_WRITE_PER_MINUTE=300

# Nginx proxy_read_timeout for the stream location must exceed
# SSE_MAX_CONNECTION_SECONDS, or nginx cuts healthy streams.
SSE_KEEPALIVE_SECONDS=15
SSE_MAX_CONNECTION_SECONDS=3600
SSE_MAX_CONNECTIONS_PER_MATCH=2000

# Public HTTPS WHIP base. Nginx strips /live and forwards to MediaMTX :8889.
# ICE media uses host UDP/TCP 8189 (not Cloudflare).
MEDIAMTX_WHIP_BASE_URL=https://api.odcc.live/live
MEDIAMTX_RTMP_BASE_URL=rtmp://103.228.134.134:1935
# Internal pull for ffmpeg restream to YouTube / Facebook (not public).
MEDIAMTX_RTSP_URL=rtsp://odcc-mediamtx:8554

# Meta app for Continue-with-Facebook on the camera phone (list Pages, start Live).
# OAuth redirect: https://odcc.live/api/v1/public/social/facebook/callback
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

MEDIA_BACKEND=local
# Absolute path inside the container; bind-mounted from /opt/odcc-api/media,
# which must be owned by uid 10001 (the image's non-root user).
MEDIA_LOCAL_DIR=/app/media
MEDIA_PUBLIC_BASE_URL=https://api.odcc.live/media
MEDIA_MAX_BYTES=5242880
MEDIA_UPLOAD_TTL_SECONDS=900

LOG_LEVEL=INFO
LOG_JSON=true
METRICS_ENABLED=true
OPENAPI_ENABLED=true
