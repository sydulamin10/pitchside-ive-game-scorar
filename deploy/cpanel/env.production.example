# Copy to ~/pitchside-api/.env on the server (never commit the real file).
# Hosts: web.odcc.nextframesoft.com + api.odcc.nextframesoft.com

ENV=production

# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-48-plus-random-chars

# Neon pooled connection string — keep sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# Upstash — must be rediss:// (TLS)
REDIS_URL=rediss://default:PASSWORD@HOST:6379

PUBLIC_WEB_URL=https://web.odcc.nextframesoft.com
PUBLIC_API_URL=https://api.odcc.nextframesoft.com
CORS_ORIGINS=https://web.odcc.nextframesoft.com
# Include localhost so curl http://127.0.0.1:8000/healthz works on the server
ALLOWED_HOSTS=api.odcc.nextframesoft.com,localhost,127.0.0.1

AUTH_REFRESH_COOKIE_ENABLED=false
ALLOW_REGISTRATION=true
OPENAPI_ENABLED=false
LOG_JSON=true
LOG_LEVEL=INFO
METRICS_ENABLED=false

MEDIA_BACKEND=local
# Replace USER with your cPanel username
MEDIA_LOCAL_DIR=/home/USER/pitchside-api/media
MEDIA_PUBLIC_BASE_URL=https://api.odcc.nextframesoft.com/media
