# Set these in Render → Environment (not as a committed .env file).

ENV=production
SECRET_KEY=generate-with-python-secrets-token-urlsafe-48

# Neon pooled URL — sslmode=require
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

# Upstash TLS URL
REDIS_URL=rediss://default:PASSWORD@HOST:6379

PUBLIC_WEB_URL=https://web.odcc.nextframesoft.com
# After custom domain is attached, use https://api.odcc.nextframesoft.com
# Until then, use your Render URL, e.g. https://pitchside-api.onrender.com
PUBLIC_API_URL=https://api.odcc.nextframesoft.com
CORS_ORIGINS=https://web.odcc.nextframesoft.com
ALLOWED_HOSTS=api.odcc.nextframesoft.com,pitchside-api.onrender.com

AUTH_REFRESH_COOKIE_ENABLED=false
ALLOW_REGISTRATION=true
OPENAPI_ENABLED=false
LOG_JSON=true
LOG_LEVEL=INFO
METRICS_ENABLED=false

# Free Render disk is ephemeral — logos reset on redeploy unless you use R2.
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=/tmp/pitchside-media
MEDIA_PUBLIC_BASE_URL=https://api.odcc.nextframesoft.com/media
