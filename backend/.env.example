# ---------------------------------------------------------------------------
# Pitchside — backend configuration
#
# Copy to `backend/.env` for local work. Never commit a real .env: the file is
# ignored by git, and every value below that is marked SECRET is enough on its
# own to impersonate the service.
#
# Only the four variables in "The short list" are needed to boot. Everything
# else has a sensible default and is here so you know it exists.
# ---------------------------------------------------------------------------

# ------------------------------------------------------ the short list
ENV=development

# Sign JWTs and HMAC receipts. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Start-up REFUSES to run in staging/production with a placeholder or anything
# under 32 characters.                                            # SECRET
SECRET_KEY=dev-secret-key-do-not-use-in-production

# Neon: copy the pooled connection string from the dashboard. Any of
# `postgres://`, `postgresql://` or `postgresql+psycopg://` is accepted and
# normalised to psycopg3. Keep `?sslmode=require` for Neon.        # SECRET
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pitchside

# Production/staging start-up runs `alembic upgrade head` so a missed Render
# pre-deploy command cannot serve new code against an old schema.
AUTO_MIGRATE=true

# Upstash: the `rediss://` URL from the database page. Leave blank and the app
# still runs — it loses cross-process fan-out for live updates and falls back to
# in-process pub/sub and an in-memory rate limiter.                # SECRET
REDIS_URL=

# ------------------------------------------------------------- addresses
# Where the browser app is served from. Used to build every share link, so if
# these are wrong, the links you hand out will be too.
PUBLIC_WEB_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8000

# Comma-separated. `*` is rejected in staging/production because credentials
# are allowed on cross-origin requests.
CORS_ORIGINS=http://localhost:5173

# Host header allow-list. Must be explicit in production (no `*`), which is what
# stops host-header poisoning of the links above.
ALLOWED_HOSTS=*

# --------------------------------------------------------------- sessions
# Access tokens are short-lived and held in memory by the browser; refresh
# tokens are opaque, rotated on every use, and a reused one revokes the family.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000

# Send the refresh token as an httpOnly cookie instead of in the JSON body.
# Only turn this on when the API and the web app share a registrable domain,
# otherwise browsers will drop it as a third-party cookie.
AUTH_REFRESH_COOKIE_ENABLED=false
AUTH_REFRESH_COOKIE_NAME=pitchside_rt
# AUTH_REFRESH_COOKIE_DOMAIN=.example.com

# Invite-only deployment: close the sign-up route.
ALLOW_REGISTRATION=true

# --------------------------------------------------------------- password
PASSWORD_MIN_LENGTH=10
# Argon2id cost. 64 MiB is the OWASP floor; raise the memory before the time
# cost, and re-check your container's memory limit if you do.
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2

# --------------------------------------------------------------- database
# Neon's pooler multiplexes connections, so keep the app pool small.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=1800
DB_POOL_PRE_PING=true
# A ceiling on any single statement. A scoring write is milliseconds; anything
# near this is a bug worth failing on.
DB_STATEMENT_TIMEOUT_MS=15000
DB_ECHO=false

# ------------------------------------------------------------------ cache
REDIS_KEY_PREFIX=pitchside
REDIS_SOCKET_TIMEOUT_SECONDS=5.0
STATE_CACHE_TTL_SECONDS=900

# ------------------------------------------------------------ rate limits
# Per identity (user id when signed in, else client address).
RATE_LIMIT_ENABLED=true
RATE_LIMIT_ANON_PER_MINUTE=120
RATE_LIMIT_USER_PER_MINUTE=600
# Login, register and refresh, per 15 minutes. Deliberately tight.
RATE_LIMIT_AUTH_PER_15MIN=20
# Scoring writes: a fast scorer peaks near 40/min, so this is generous.
RATE_LIMIT_WRITE_PER_MINUTE=300

# --------------------------------------------------------------- realtime
SSE_KEEPALIVE_SECONDS=15
# Streams are recycled on purpose; the client reconnects seamlessly and no
# proxy gets to decide the lifetime for us.
SSE_MAX_CONNECTION_SECONDS=3600
SSE_MAX_CONNECTIONS_PER_MATCH=2000

# ---------------------------------------------------------- request limits
MAX_REQUEST_BODY_BYTES=1048576

# ----------------------------------------------------------------- media
# local = store under MEDIA_LOCAL_DIR and serve at /media in development.
# r2 = Cloudflare R2 (S3 API) signed PUT uploads; set bucket + keys below.
MEDIA_BACKEND=local
MEDIA_LOCAL_DIR=media
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com
MEDIA_MAX_BYTES=5242880
MEDIA_UPLOAD_TTL_SECONDS=900
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=pitchside-media
# R2_PUBLIC_BASE_URL=https://media.example.com
# R2_ENDPOINT_URL=

# -------------------------------------------------------------- streaming
# MediaMTX WHIP publish base and RTMP ingest base for camera → restream.
# Phones need a public HTTPS origin (not localhost). Example:
# MEDIAMTX_WHIP_BASE_URL=https://stream.example.com:8889
MEDIAMTX_WHIP_BASE_URL=http://localhost:8889
MEDIAMTX_RTMP_BASE_URL=rtmp://localhost:1935
MEDIAMTX_RTSP_URL=rtsp://127.0.0.1:8554

# Meta app so a cameraman can Connect Facebook, pick Timeline or a Page, and
# Go live without pasting a stream key. Paste App ID + Secret on Admin → Facebook
# Live, or set them here. Create the app at developers.facebook.com, add
# Facebook Login, and set the Valid OAuth Redirect URI to:
#   {PUBLIC_WEB_URL}/api/v1/public/social/facebook/callback
# Development mode only lets app testers / admins log in until App Review.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ---------------------------------------------------------- observability
LOG_LEVEL=INFO
# JSON for a log aggregator; set false for readable local output.
LOG_JSON=true
METRICS_ENABLED=true
# SENTRY_DSN=
# Serve /docs and the OpenAPI schema. Consider false for a private deployment.
OPENAPI_ENABLED=true

# ------------------------------------------------------------------ tests
# Integration tests are skipped unless this points at a database they may
# TRUNCATE between tests. Never point it at anything you care about.
# TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pitchside_test
